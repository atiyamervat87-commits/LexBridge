<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>LIVE PLATFORM</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,sans-serif;background:#08090d;color:#fff}
body{overflow-x:hidden}
button,input{font:inherit}
button{cursor:pointer}
.screen{min-height:100vh;padding:24px 18px 100px}
.center-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.card{width:min(460px,100%);background:#14161d;border:1px solid #292d38;border-radius:26px;padding:28px;box-shadow:0 20px 60px #0008}
.logo{width:68px;height:68px;border-radius:22px;background:#e51e46;display:grid;place-items:center;font-size:32px;margin:0 auto 20px}
h1,h2,h3,p{margin-top:0}
.title{text-align:center;font-size:27px;margin-bottom:10px}
.sub{text-align:center;color:#9da3b2;line-height:1.8;margin-bottom:26px}
.primary{width:100%;border:0;border-radius:16px;padding:15px;background:#e51e46;color:#fff;font-weight:800}
.secondary{width:100%;border:1px solid #343946;border-radius:16px;padding:14px;background:#1a1c24;color:#fff}
.input{width:100%;padding:15px;border-radius:15px;border:1px solid #343946;background:#0e1016;color:#fff;outline:0;margin-bottom:14px}
.app{display:none}
.header{padding:18px;position:sticky;top:0;z-index:20;background:#08090dee;border-bottom:1px solid #20232c;backdrop-filter:blur(18px)}
.header-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:42px;height:42px;border-radius:14px;background:#e51e46;display:grid;place-items:center}
.brand-title{font-size:17px;font-weight:800}
.brand-sub{font-size:11px;color:#8f95a3;margin-top:3px}
.connection{font-size:11px;color:#aeb4c1}
.main{padding:20px 16px 100px}
.screen-page{display:none}
.screen-page.active{display:block}
.hero{padding:25px 20px;border-radius:24px;background:linear-gradient(135deg,#1b1d26,#292d38);margin-bottom:22px}
.hero h1{font-size:26px;margin-bottom:8px}
.hero p{color:#aeb4c1;margin:0;line-height:1.7}
.section-title{display:flex;justify-content:space-between;align-items:center;margin:20px 2px 12px}
.section-title h2{font-size:19px}
.section-title span{font-size:12px;color:#8f95a3}
.rooms{display:grid;gap:14px}
.room{background:#151821;border:1px solid #292d38;border-radius:21px;padding:17px;transition:.15s}
.room:active{transform:scale(.98)}
.room-top{display:flex;justify-content:space-between;align-items:center}
.avatar{width:54px;height:54px;border-radius:18px;background:#222632;display:grid;place-items:center;font-size:28px}
.live{color:#ff5272;font-size:12px;font-weight:800}
.room h2{font-size:18px;margin:14px 0 5px}
.room p{color:#9da3b2;margin:0;font-size:13px}
.empty{background:#14161d;border:1px solid #292d38;border-radius:22px;padding:45px 20px;text-align:center;color:#aeb4c1}
.profile{display:flex;align-items:center;gap:14px;background:#14161d;border:1px solid #292d38;border-radius:22px;padding:20px;margin-bottom:16px}
.profile-avatar{width:60px;height:60px;border-radius:20px;background:#242834;display:grid;place-items:center;font-size:30px}
.profile small{display:block;color:#969dac;margin-top:5px}
.status{display:grid;gap:12px}
.status-card{background:#14161d;border:1px solid #292d38;border-radius:18px;padding:17px}
.status-card small{display:block;color:#8f95a3;margin-bottom:7px}
.bottom{position:fixed;bottom:0;left:0;right:0;z-index:100;background:#0c0e13f5;border-top:1px solid #292d38;backdrop-filter:blur(18px);padding:8px 8px calc(8px + env(safe-area-inset-bottom))}
.bottom-inner{display:grid;grid-template-columns:repeat(4,1fr);max-width:600px;margin:auto}
.nav{border:0;background:none;color:#858b99;padding:8px 3px;font-size:11px}
.nav span{display:block;font-size:20px;margin-bottom:3px}
.nav.active{color:#fff}
#chat{display:none}
</style>
</head>
<body>

