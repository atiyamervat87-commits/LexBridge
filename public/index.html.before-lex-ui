<section id="permissionScreen" class="center-screen">
  <div class="card">
    <div class="logo">🔴</div>
    <h1 class="title">LIVE PLATFORM</h1>
    <p class="sub">قبل الدخول، وافق على صلاحيات الكاميرا والميكروفون حتى تتمكن من استخدام البث المباشر.</p>
    <button id="permissionDone" class="primary" type="button">تم</button>
  </div>
</section>

