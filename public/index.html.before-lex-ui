<script>
document.getElementById("permissionDone").addEventListener("click", async () => {
  try {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      alert("المتصفح لا يدعم صلاحيات الكاميرا والميكروفون.");
    } else {
      const stream = await navigator.mediaDevices.getUserMedia({video:true,audio:true});
      stream.getTracks().forEach(t => t.stop());
    }
  } catch (e) {
    console.warn("PERMISSION_REQUEST:", e);
  }
  document.getElementById("permissionScreen").style.display="none";
  document.getElementById("loginScreen").style.display="flex";
});
</script>

<script>
let currentRoom="";
let user="";

function showScreen(name){
  // إخفاء كل الصفحات
  document.querySelectorAll(".screen-page").forEach(x=>{
    x.classList.remove("active");
  });

  // إخفاء غرفة البث عند استخدام شريط التنقل
  const chat = document.getElementById("chat");
  if(chat) chat.style.display = "none";

  // إظهار الصفحة المطلوبة
  const target = document.getElementById(name + "Screen");
  if(target) target.classList.add("active");

  // تحديث الزر النشط
  document.querySelectorAll(".nav").forEach(x=>{
    x.classList.toggle("active", x.dataset.screen === name);
  });

  // تحديث بيانات الحساب
  if(name === "account"){
    const u = document.getElementById("accountUser");
    const r = document.getElementById("accountRoom");
    const c = document.getElementById("accountConnection");

    if(u) u.textContent = user || "زائر";
    if(r) r.textContent = currentRoom || "لا توجد غرفة";

    if(c){
      c.textContent =
        typeof socket !== "undefined" && socket.connected
          ? "🟢 متصل بالخادم"
          : "🔴 غير متصل بالخادم";
    }
  }
}

document.querySelectorAll(".nav").forEach(btn=>{
  btn.addEventListener("click",()=>{
    const name = btn.dataset.screen;
    if(name) showScreen(name);
  });
});

document.getElementById("loginBtn").addEventListener("click",()=>{
  const value=document.getElementById("loginName").value.trim();
  if(!value){
    alert("اكتب اسم المستخدم أولاً.");
    return;
  }
  user=value;
  document.getElementById("loginScreen").style.display="none";
  document.getElementById("app").style.display="block";
  showScreen("home");
});

document.getElementById("loginName").addEventListener("keydown",e=>{
  if(e.key==="Enter") document.getElementById("loginBtn").click();
});

function openRoom(room,avatar){
  currentRoom=room;

  const choice=document.createElement("div");
  choice.className="entry-modal";
  choice.style.cssText="position:fixed;inset:0;z-index:99999;background:#000b;display:grid;place-items:center;padding:20px";
  choice.innerHTML=`
    <div style="width:min(420px,100%);background:#151821;border:1px solid #303542;border-radius:24px;padding:24px;text-align:center">
      <div style="font-size:45px">${avatar}</div>
      <h2>${room}</h2>
      <p style="color:#aeb4c1">اختر طريقة الدخول إلى الغرفة</p>
      <button type="button" id="hostBtn" class="primary">👑 دخول كمضيف</button>
      <br><br>
      <button type="button" id="viewerBtn" class="secondary">👥 دخول كمشاهد</button>
      <br><br>
      <button type="button" id="cancelBtn" class="secondary">إلغاء</button>
    </div>`;
  document.body.appendChild(choice);

  const enter=role=>{
    choice.remove();
    const title=document.getElementById("roomTitle");
    const panel=document.getElementById("chat");
    const logBox=document.getElementById("log");

    if(title) title.textContent=avatar+" "+room;
    if(panel) panel.style.display="block";
    if(logBox) logBox.innerHTML="";

    if(!socket.connected){
      alert("الاتصال بالخادم غير متاح.");
      return;
    }

    socket.emit("join-room",{room,user,role});
    if(role==="viewer") setTimeout(()=>socket.emit("request-host"),500);
  };

  document.getElementById("hostBtn").onclick=()=>enter("host");
  document.getElementById("viewerBtn").onclick=()=>enter("viewer");
  document.getElementById("cancelBtn").onclick=()=>choice.remove();
}

function closeRoom(){
  if(typeof socket !== "undefined" && socket.connected){
    socket.emit("leave-room");
  }

  const panel = document.getElementById("chat");
  const logBox = document.getElementById("log");

  if(panel) panel.style.display = "none";
  if(logBox) logBox.innerHTML = "";

  currentRoom = "";

  const accountRoom = document.getElementById("accountRoom");
  if(accountRoom) accountRoom.textContent = "لا توجد غرفة";

  showScreen("home");
}
</script>
<script src="/socket.io/socket.io.js"></script>
<script>
const socket=io({
    transports:["websocket","polling"],
    upgrade:true,
    rememberUpgrade:true,
    reconnection:true,
    reconnectionAttempts:Infinity,
    reconnectionDelay:1000,
    reconnectionDelayMax:5000,
    timeout:20000
});

socket.on("connect",()=>{
    console.log("SOCKET_CONNECTED",socket.id);
});

socket.on("connect_error",err=>{
    console.error("SOCKET_CONNECT_ERROR",err);
});

socket.on("disconnect",reason=>{
    console.warn("SOCKET_DISCONNECTED",reason);
});

function webRTCLog(...args){
    console.log(...args);

    const box=document.getElementById("webrtcDebugLog");
    if(!box) return;

    const line=document.createElement("div");
    line.textContent=new Date().toLocaleTimeString()+" | "+args.map(x=>{
        try{
            return typeof x==="string" ? x : JSON.stringify(x);
        }catch{
            return String(x);
        }
    }).join(" ");

    box.appendChild(line);

    while(box.children.length > 80){
        box.removeChild(box.firstChild);
    }

    box.scrollTop=box.scrollHeight;
}

webRTCLog("DEBUG_READY");

const peers = new Map();
const pendingIce = new Map();
const remoteDescriptionsReady = new Set();
let localStream = null;

async function startBroadcast(){
    if(!currentRoom) {
        alert("ادخل غرفة أولاً.");
        return;
    }

    try{
        webRTCLog("GET_USER_MEDIA_START");
        localStream = await navigator.mediaDevices.getUserMedia({
            video:true,
            audio:true
        });

        const video=document.getElementById("localVideo");
        video.srcObject=localStream;
        video.style.display="block";

        webRTCLog("START_BROADCAST_EMIT");
        socket.emit("start-broadcast");
        await flushPendingViewers();
        alert("📹 تم تشغيل الكاميرا والميكروفون.");
    }catch(err){
        console.error(err);
        alert("تعذر الوصول إلى الكاميرا أو الميكروفون.");
    }
}

function stopBroadcast(){
    if(localStream){
        localStream.getTracks().forEach(track=>track.stop());
        localStream=null;
    }

    const video=document.getElementById("localVideo");
    if(video){
        video.srcObject=null;
        video.style.display="none";
    }

    for(const pc of peers.values()) pc.close();
    peers.clear();
}

async function createPeer(targetId){
    if(peers.has(targetId)) return peers.get(targetId);

    const pc=new RTCPeerConnection({
        iceServers:[
            {urls:"stun:stun.l.google.com:19302"}
        ]
    });

    peers.set(targetId,pc);
    pendingIce.set(targetId, []);
    remoteDescriptionsReady.delete(targetId);

    if(localStream){
        for(const track of localStream.getTracks()){
            pc.addTrack(track,localStream);
        }
    }

    pc.onicecandidate=e=>{
        if(e.candidate){
            webRTCLog("WEBRTC_ICE_SEND", targetId, e.candidate.candidate);
            socket.emit("webrtc-ice",{
                to:targetId,
                candidate:e.candidate
            });
        } else {
            webRTCLog("WEBRTC_ICE_COMPLETE", targetId);
        }
    };

    pc.oniceconnectionstatechange=()=>{
        webRTCLog("WEBRTC_ICE_STATE", targetId, pc.iceConnectionState);
    };

    pc.onconnectionstatechange=()=>{
        webRTCLog("WEBRTC_CONNECTION_STATE", targetId, pc.connectionState);
    };

    pc.onsignalingstatechange=()=>{
        webRTCLog("WEBRTC_SIGNALING_STATE", targetId, pc.signalingState);
    };

    pc.ontrack=async e=>{
        webRTCLog("WEBRTC_ONTRACK", targetId, e.streams?.length, e.track?.kind, e.track?.readyState);

        let v=document.getElementById("remote-"+targetId);

        if(!v){
            v=document.createElement("video");
            v.id="remote-"+targetId;
            v.autoplay=true;
            v.playsInline=true;
            v.style.cssText=
                "width:100%;max-height:320px;background:#000;border-radius:18px";
            document.getElementById("remoteVideos").appendChild(v);
        }

        v.srcObject=e.streams[0];

        const empty=document.getElementById("mediaEmpty");
        if(empty) empty.style.display="none";
        v.style.display="block";

        try{
            await v.play();
        }catch(err){
            console.warn("REMOTE_VIDEO_PLAY:",err);
        }
    };

    return pc;
}

const pendingViewers = new Map();

async function connectViewer(viewerId, viewerName){
    if(!viewerId) return;

    if(!localStream){
        webRTCLog("WEBRTC_QUEUE_VIEWER", viewerId);
        pendingViewers.set(viewerId, viewerName || "مشاهد");
        return;
    }

    webRTCLog("WEBRTC_CREATE_OFFER", viewerId);

    try{
        const pc = await createPeer(viewerId);
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);

        webRTCLog("WEBRTC_OFFER_SEND", viewerId);

        socket.emit("webrtc-offer", {
            to: viewerId,
            offer: offer
        });
    }catch(err){
        webRTCLog("WEBRTC_OFFER_ERROR", viewerId, err);
    }
}

async function flushPendingViewers(){
    if(!localStream || !pendingViewers.size) return;

    const viewers = [...pendingViewers.entries()];
    pendingViewers.clear();

    for(const [viewerId, viewerName] of viewers){
        await connectViewer(viewerId, viewerName);
    }
}

socket.on("viewer-ready", async data=>{
    webRTCLog("WEBRTC_VIEWER_READY", data);
    await connectViewer(data?.viewerId, data?.viewerName);
});

socket.on("webrtc-offer",async data=>{
    console.log("WEBRTC_OFFER_RECEIVED:", data?.from);

    if(!data?.from) return;

    const pc=await createPeer(data.from);

    await pc.setRemoteDescription(
        new RTCSessionDescription(data.offer)
    );

    remoteDescriptionsReady.add(data.from);

    const queued=pendingIce.get(data.from) || [];
    for(const candidate of queued){
        try{
            await pc.addIceCandidate(
                new RTCIceCandidate(candidate)
            );
        }catch(err){
            console.error("QUEUED_ICE_ERROR:",err);
        }
    }
    pendingIce.set(data.from, []);

    const answer=await pc.createAnswer();
    await pc.setLocalDescription(answer);

    socket.emit("webrtc-answer",{
        to:data.from,
        answer:answer
    });
});

socket.on("webrtc-answer",async data=>{
    console.log("WEBRTC_ANSWER_RECEIVED:", data?.from);

    const pc=peers.get(data?.from);
    if(!pc) return;

    await pc.setRemoteDescription(
        new RTCSessionDescription(data.answer)
    );

    remoteDescriptionsReady.add(data.from);

    const queued=pendingIce.get(data.from) || [];
    for(const candidate of queued){
        try{
            await pc.addIceCandidate(
                new RTCIceCandidate(candidate)
            );
        }catch(err){
            console.error("QUEUED_ICE_ERROR:",err);
        }
    }
    pendingIce.set(data.from, []);
});

socket.on("webrtc-ice",async data=>{
    console.log("WEBRTC_ICE_RECEIVED:", data?.from);

    const from=data?.from;
    const candidate=data?.candidate;
    if(!from || !candidate) return;

    const pc=peers.get(from);

    if(!pc || !pc.remoteDescription){
        if(!pendingIce.has(from)) pendingIce.set(from,[]);
        pendingIce.get(from).push(candidate);
        return;
    }

    try{
        await pc.addIceCandidate(
            new RTCIceCandidate(candidate)
        );
    }catch(err){
        console.error("ICE_ERROR:",err);
    }
});

</script>



<script>
/* ===== CONNECTION RECOVERY ===== */

function updateConnectionUI(text){
  const el = document.getElementById("connectionText");
  if(el) el.textContent = text;

  const account = document.getElementById("accountConnection");
  if(account){
    account.textContent =
      (typeof socket !== "undefined" && socket.connected)
        ? "🟢 متصل بالخادم"
        : "🔴 غير متصل بالخادم";
  }
}

if(typeof socket !== "undefined"){

  socket.on("connect", ()=>{
    console.log("SOCKET_CONNECTED:", socket.id);
    updateConnectionUI("🟢 متصل");

    // إذا كان المستخدم داخل غرفة، أعد الانضمام بعد عودة الاتصال
    if(currentRoom && user){
      console.log("REJOIN_AFTER_RECONNECT:", {
        room: currentRoom,
        user: user
      });

      socket.emit("join-room",{
        room: currentRoom,
        user: user,
        role: window.currentRole || "viewer"
      });
    }
  });

  socket.on("disconnect",(reason)=>{
    console.log("SOCKET_DISCONNECTED:", reason);
    updateConnectionUI("🔴 إعادة الاتصال...");
  });

  socket.on("connect_error",(err)=>{
    console.warn("SOCKET_CONNECT_ERROR:", err && err.message);
    updateConnectionUI("🟠 محاولة الاتصال...");
  });

  socket.io.on("reconnect_attempt",(attempt)=>{
    console.log("SOCKET_RECONNECT_ATTEMPT:", attempt);
    updateConnectionUI("🟠 إعادة الاتصال...");
  });

  socket.io.on("reconnect", (attempt)=>{
    console.log("SOCKET_RECONNECTED:", attempt);
    updateConnectionUI("🟢 متصل");
  });
}
</script>

