<section id="loginScreen" class="center-screen" style="display:none">
  <div class="card">
    <div class="logo">👤</div>
    <h1 class="title">تسجيل الدخول</h1>
    <p class="sub">اكتب اسمك للدخول إلى منصة البث.</p>
    <input id="loginName" class="input" type="text" placeholder="اسم المستخدم" autocomplete="off">
    <button id="loginBtn" class="primary" type="button">دخول</button>
  </div>
</section>

