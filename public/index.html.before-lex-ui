    <section id="discoverScreen" class="screen-page">
      <div class="section-title"><h2>🔎 اكتشاف</h2><span>مباشر الآن</span></div>
      <div class="rooms">
        <div class="room" onclick="openRoom('الغرفة الأولى','👩🏻‍🎤')">
          <div class="room-top"><div class="avatar">👩🏻‍🎤</div><span class="live">● مباشر</span></div>
          <h2>الغرفة الأولى</h2><p>🎙️ مضيف مباشر</p>
        </div>
        <div class="room" onclick="openRoom('الغرفة الثانية','👨🏻‍🎤')">
          <div class="room-top"><div class="avatar">👨🏻‍🎤</div><span class="live">● مباشر</span></div>
          <h2>الغرفة الثانية</h2><p>👥 24 مشاهد</p>
        </div>
        <div class="room" onclick="openRoom('غرفة الأصدقاء','🎙️')">
          <div class="room-top"><div class="avatar">🎙️</div><span class="live">● مباشر</span></div>
          <h2>غرفة الأصدقاء</h2><p>👥 12 مشاهد</p>
